{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run --no-sync pytest:*)",
      "Bash(uv run --no-sync ruff check:*)",
      "Bash(uv run --no-sync python scripts/generate_demo_corpus.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(pwsh -NoProfile -Command *scripts/kdd.ps1*)",
      "Bash(pwsh -NoProfile -Command *scripts/check-kdd-lifecycle.ps1*)",
      "Bash(pwsh -NoProfile -Command *scripts/check-public-safety.ps1*)",
      "Bash(pwsh -NoProfile -Command *scripts/test-public-safety.ps1*)",
      "Bash(pwsh -NoProfile -Command *scripts/verify.ps1*)"
    ]
  }
}
