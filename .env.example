RAG_DOCS_SOURCES_FILE=config/sources.yaml
RAG_DOCS_QDRANT_URL=http://127.0.0.1:6333
RAG_DOCS_QDRANT_COLLECTION=rag_docs
RAG_DOCS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_DOCS_OLLAMA_URL=http://127.0.0.1:11434
RAG_DOCS_OLLAMA_MODEL=qwen2.5:3b
RAG_DOCS_OLLAMA_TIMEOUT=180
RAG_DOCS_OLLAMA_TEMPERATURE=0
RAG_DOCS_OLLAMA_SEED=0
RAG_DOCS_OLLAMA_ACTIVE_PROFILE=local
RAG_DOCS_OLLAMA_LOCAL_URL=http://127.0.0.1:11434
RAG_DOCS_OLLAMA_LOCAL_MODEL=qwen2.5:3b
# Descomenta y adapta estas variables para habilitar el selector remoto en la web.
# El modelo es el valor inicial; después se pueden descubrir y seleccionar los instalados.
# RAG_DOCS_OLLAMA_REMOTE_URL=http://ollama-host.example.test:11434
# RAG_DOCS_OLLAMA_REMOTE_MODEL=qwen2.5:3b
RAG_DOCS_RETRIEVAL_TOP_K=8
RAG_DOCS_CONTEXT_CHUNKS=5
RAG_DOCS_MIN_SCORE=0.45
