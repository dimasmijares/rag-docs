		summarizeBy: none
		sourceColumn: recall_at_5

	column recall_at_8
		dataType: double
		formatString: 0.000
		summarizeBy: none
		sourceColumn: recall_at_8

	column reciprocal_rank
		dataType: double
		formatString: 0.000
		summarizeBy: none
		sourceColumn: reciprocal_rank

	column precision_at_1
